#!/bin/bash
set -euxo pipefail
source /root/.bashrc || true

cp -rf /opt/workshop/module-1-durable-agent/solution/. /root/workshop/module-1-durable-agent/exercise/

pkill -f "python -m worker" || true
sleep 1

cd /root/workshop/module-1-durable-agent/solution
nohup uv run python -m worker > /tmp/solve-01-durable-agent-worker.log 2>&1 &
WORKER_PID=$!
sleep 12

timeout 120 uv run python -m start_workflow "What is the weather in Melbourne right now?" || true

kill "$WORKER_PID" 2>/dev/null || true
exit 0
