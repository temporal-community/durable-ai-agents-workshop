#!/bin/bash
set -euo pipefail

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="durable-tools-tq" AND ExecutionStatus="Completed"' \
    --limit 1 2>/dev/null | grep -c "Completed" || true)

if [[ "${COMPLETED}" -lt 1 ]]; then
    echo "FAIL: No completed workflows on durable-tools-tq. Start a workflow and wait for it to finish."
    exit 1
fi

echo "OK: a workflow completed on durable-tools-tq."
exit 0
