#!/bin/bash
set -euxo pipefail
source /root/.bashrc || true

cp -rf /opt/workshop/modules/02-durable-tools/solution/. /root/workshop/modules/02-durable-tools/exercise/

pkill -f "python -m worker" || true
sleep 1

cd /root/workshop/modules/02-durable-tools/solution
nohup uv run python -m worker > /tmp/solve-02-durable-tools-worker.log 2>&1 &
WORKER_PID=$!
sleep 12

timeout 120 uv run python -m start_workflow "Where am I, and what is the weather there?" || true

kill "$WORKER_PID" 2>/dev/null || true
exit 0
